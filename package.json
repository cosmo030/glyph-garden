{
  "name": "glyph-garden",
  "version": "0.2.0",
  "description": "A new-tab page full of animated animals made of keyboard characters",
  "license": "MIT",
  "author": "cosmo030",
  "homepage": "https://github.com/cosmo030/glyph-garden#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cosmo030/glyph-garden.git"
  },
  "bugs": {
    "url": "https://github.com/cosmo030/glyph-garden/issues"
  },
  "keywords": [
    "browser-extension",
    "new-tab",
    "ascii",
    "webgl",
    "koi",
    "chrome",
    "firefox"
  ],
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip && wxt zip -b firefox",
    "preview:build": "vite build --config vite.preview.config.ts",
    "preview:serve": "vite --config vite.preview.config.ts",
    "typecheck": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run format:check"
  },
  "devDependencies": {
    "@tweakpane/core": "^2.0.5",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wxt": "^0.21.5"
  },
  "dependencies": {
    "tweakpane": "^4.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
