# Store publishing credentials. Nothing in the app itself needs these.
#
# Copy this file to `.env` (which is git-ignored) and fill in your own values.
# Never commit real values. In GitHub Actions, add them as repository secrets instead.
#
# These are the variable names `wxt submit` reads when uploading a new version.

# Chrome Web Store (https://developer.chrome.com/docs/webstore/using-api)
CHROME_EXTENSION_ID=
CHROME_CLIENT_ID=
CHROME_CLIENT_SECRET=
CHROME_REFRESH_TOKEN=

# Firefox Add-ons (https://addons.mozilla.org/developers/addon/api/key/)
FIREFOX_EXTENSION_ID=
FIREFOX_JWT_ISSUER=
FIREFOX_JWT_SECRET=
